# Polymarket API Configuration
# Get your API keys from: https://docs.polymarket.com/

# Private key for signing transactions (NEVER share this!)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Chain ID (137 for Polygon mainnet, 80002 for Polygon Amoy testnet)
POLYMARKET_CHAIN_ID=137

# API endpoints
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_FUNDER=0x0000000000000000000000000000000000000000

# L2 Authentication (Optional - generated via get_api_key.py)
CLOB_API_KEY=your_api_key_here
CLOB_SECRET=your_secret_here
CLOB_PASSPHRASE=your_passphrase_here

# Trading Configuration
POLL_INTERVAL=1.0
SPIKE_THRESHOLD=0.03
POSITION_SIZE=5.0
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_DRAWDOWN=50.0

# Paper Trading
PAPER_TRADING=true
INITIAL_BALANCE=100.0
MIN_POSITION_SIZE=1.0
MAX_OPEN_POSITIONS=10

# Market Monitoring
MONITOR_STRATEGY=volume
MAX_MONITORED_MARKETS=50
MIN_MARKET_VOLUME=0.0
PRICE_HISTORY_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
